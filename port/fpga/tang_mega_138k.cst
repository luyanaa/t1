// Sipeed Tang Mega 138K Pro Dock (GW5AST-LV138FPG676AC1/I0).
// LED and button pins are copied from the Amaranth board definition;
// LEDs and the reset button are both active-low.

IO_LOC "clk" P16;
IO_PORT "clk" IO_TYPE=LVCMOS33;

IO_LOC "reset_l" K16;
IO_PORT "reset_l" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "led[0]" R26;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[1]" J14;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[2]" L20;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[3]" M25;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[4]" N21;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led[5]" N23;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;